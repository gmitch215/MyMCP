{
	"name": "@gmitch215/mymcp",
	"version": "1.0.0",
	"description": "Custom MCP servers from any API",
	"type": "module",
	"license": "MPL-2.0",
	"author": "Gregory Mitchell",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gmitch215/MyMCP.git"
	},
	"bugs": {
		"url": "https://github.com/gmitch215/MyMCP/issues"
	},
	"homepage": "https://github.com/gmitch215/MyMCP#readme",
	"types": "./dist/lib.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/lib.d.ts",
			"import": "./dist/lib.js"
		}
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"prepack": "bun run build",
		"dev": "bunx wrangler dev --port 8787",
		"deploy": "bunx wrangler deploy",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "INTEGRATION=1 vitest run",
		"test:e2e:coverage": "INTEGRATION=1 vitest run --coverage",
		"servers:check": "bun run scripts/check-servers.ts",
		"outputs:check": "bun run scripts/check-outputs.ts",
		"evals": "bun run evals/run.ts",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"prepare": "husky install"
	},
	"dependencies": {
		"yaml": "^2.8.1"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": ">=5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260908.1",
		"@modelcontextprotocol/sdk": "^1.22.0",
		"@types/bun": "^1.4.0",
		"@vitest/coverage-istanbul": "^4.1.10",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.130.0"
	},
	"lint-staged": {
		"*.{js,ts,json,md,yml}": "prettier --write"
	}
}
